# Render API Web Service. Add these values in Render Environment settings.
# Dockerfile: apps/api/Dockerfile; build context: repository root.
NODE_ENV=production
API_PORT=4000
PORT=4000
DATABASE_URL=<postgresql-runtime-url>
DIRECT_URL=<postgresql-migration-url>
JWT_SECRET=<generate-a-random-secret>
JWT_EXPIRES_IN=7d
BLOCKCHAIN_RPC_URL=<private-sepolia-rpc-url>
CONTRACT_ADDRESS=0x74fd4f89b8ab7a3100b3291b7aeb43448f13c43a
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_ABI_READY=true
AUTO_SEED=false
WEB_URL=https://<vercel-web-domain>
